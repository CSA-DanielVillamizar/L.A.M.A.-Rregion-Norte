    <style>
        * {
            font-family: 'Space Grotesk', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1919 0%, #2d2d2d 100%);
        }

        .lamaBlack {
            background-color: #1a1919;
        }

        .lamaGold {
            color: #f2d00d;
        }

        .lamaNeon {
            color: #00f5d4;
        }

        .lamaBone {
            color: #e1e4dc;
        }

        .glass-panel {
            background: rgba(26, 25, 25, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(242, 208, 13, 0.2);
        }

        .glow-neon {
            box-shadow: 0 0 20px rgba(0, 245, 212, 0.3);
        }

        .glow-gold {
            box-shadow: 0 0 15px rgba(242, 208, 13, 0.3);
        }

        .map-grid {
            background-image: radial-gradient(circle, rgba(0, 245, 212, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        #map {
            width: 100%;
            height: 100%;
            border-radius: 12px;
        }

        .leaflet-control-attribution {
            display: none;
        }

        .itinerario-layout {
            min-height: 75vh;
        }

        @media (max-width: 1279px) {
            .itinerario-layout {
                min-height: auto;
            }
        }
