# ==========================================
# CONFIGURACIÓN DE ENTORNO - REGIONNORTELAMACOLOMBIA
# ==========================================

# Entorno
NODE_ENV=development
PORT=3000

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=lama_db
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=your-secure-password
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
# Solo para entorno local si el certificado no es confiable
AZURE_SQL_TRUST_CERT=false

# Seguridad del panel admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# API Key para endpoints protegidos
API_KEY=your-api-key

# Punto de control MTO (check-in por QR) - credenciales propias del dispositivo
# de recepción, separadas de ADMIN_USERNAME/ADMIN_PASSWORD
MTO_USERNAME=mto
MTO_PASSWORD=your-mto-password

# URL pública de la app, usada para construir el enlace codificado en el QR
# (opcional: si se omite, se deriva del host de la request entrante)
APP_BASE_URL=https://lamaregionnorte.azurewebsites.net

# ==========================================
# BOOTSTRAP / REINSTALL (opcional)
# ==========================================
# Valores sugeridos para reprovisionamiento completo en Azure
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=rg-lamaregionnorte-prod
AZURE_LOCATION=centralus
AZURE_APP_SERVICE_PLAN=plan-lamaregionnorte-prod
AZURE_APP_SERVICE_NAME=lamaregionnorte
AZURE_SQL_SERVER_NAME=lamaregionnorte-sql-a90e
