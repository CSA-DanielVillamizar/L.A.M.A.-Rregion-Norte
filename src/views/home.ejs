<%- include('partials/header') %>

    <!-- Hero Section -->
    <header class="relative min-h-[80vh] flex flex-col justify-center items-center text-center px-4 overflow-hidden">
        <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="metadata">
            <source src="/video/golfo-morrosquillo.mp4" type="video/mp4">
        </video>
        <div class="absolute inset-0 bg-black/60"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-lamaBlack via-transparent to-transparent"></div>

        <div class="relative z-10 w-full max-w-4xl animate-fade-in-up px-2 sm:px-0">
            <h1 class="text-4xl sm:text-6xl md:text-8xl font-headings mb-2 text-white leading-tight break-words">
                V Campeonato Región Norte
                <span
                    class="font-accent text-lamaNeon neon-text text-3xl sm:text-5xl md:text-7xl block md:inline mt-3 md:mt-0 break-words">
                    Golfo de Morrosquillo · Coveñas
                </span>
            </h1>
            <h2 class="text-2xl sm:text-3xl md:text-5xl font-headings text-lamaGold mt-4 break-words">
                RUTA REGIONAL DE HERMANDAD Y MOTOTURISMO
            </h2>
            <p
                class="mt-6 sm:mt-8 text-base sm:text-lg md:text-xl max-w-2xl mx-auto text-lamaBone font-light leading-relaxed">
                Priorizamos la rodada segura, el disfrute de las maquinas y la economia del socio en una experiencia
                premium junto al Golfo de Morrosquillo.
            </p>
            <div class="mt-10 flex flex-col md:flex-row gap-4 justify-center">
                <a href="/registro-campeonato"
                    class="cta-glow w-full md:w-auto bg-lamaGold text-lamaBlack font-bold py-3 px-8 rounded hover:bg-white transition-colors cursor-pointer text-center min-h-[48px] flex items-center justify-center">
                    <%= hero.eventDate %>
                </a>
                <a href="/eventos/vnorte-2026"
                    class="w-full md:w-auto border-2 border-lamaNeon text-lamaNeon font-bold py-3 px-8 rounded hover:bg-lamaNeon hover:text-lamaBlack transition-colors text-center min-h-[48px] flex items-center justify-center">
                    RUTA COVEÑAS
                </a>
            </div>
        </div>
    </header>

    <!-- Features Section -->
    <section class="container mx-auto px-4 py-24">
        <h2 class="text-4xl md:text-6xl font-headings text-center text-lamaGold mb-16 tracking-widest">
            LA EXPERIENCIA
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <% features.forEach(function(feature) { %>
                <div
                    class="bg-lamaDark p-8 rounded-lg border border-gray-800 hover:border-lamaNeon transition-all shadow-xl hover:shadow-2xl hover:shadow-lamaNeon/20 text-center">
                    <div class="text-lamaNeon mb-4 flex justify-center"><%- feature.icon %></div>
                    <h3 class="text-2xl font-headings text-lamaGold mb-4 tracking-wider">
                        <%= feature.title %>
                    </h3>
                    <p class="text-lamaBone">
                        <%= feature.description %>
                    </p>
                </div>
                <% }); %>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="bg-lamaDark py-16 border-y border-gray-800">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div>
                    <div class="text-6xl font-headings text-lamaNeon neon-text mb-2">
                        <%= stats.miembros %>
                    </div>
                    <p class="text-lamaGold font-bold tracking-wider">MIEMBROS ACTIVOS</p>
                </div>
                <div>
                    <div class="text-6xl font-headings text-lamaGold mb-2">
                        <%= stats.eventos %>
                    </div>
                    <p class="text-lamaGold font-bold tracking-wider">EVENTOS ANUALES</p>
                </div>
                <div>
                    <div class="text-6xl font-headings text-lamaNeon neon-text mb-2">
                        <%= stats.capitulos %>
                    </div>
                    <p class="text-lamaGold font-bold tracking-wider">CAPÍTULOS</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Alojamiento: Centros de Comando -->
    <section class="container mx-auto px-4 py-24">
        <h2 class="text-4xl md:text-6xl font-headings text-center text-lamaGold mb-4 tracking-widest">
            BASES OPERATIVAS
        </h2>
        <p class="text-center text-lamaBone mb-4 text-lg max-w-3xl mx-auto">
            Hemos auditado infraestructuras que garantizan un perímetro cerrado y vigilancia ininterrumpida para
            salvaguardar nuestro patrimonio rodante. Asegura tu reserva con anticipación.
        </p>
        <p class="text-center text-gray-400 text-sm mb-16 max-w-3xl mx-auto">
            El Hotel Playa Coveñas es la sede oficial del evento. Las siguientes opciones son alternativas para
            cotizar si prefieres otro perfil de hospedaje o si la sede ya no tiene capacidad disponible.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% (hoteles || []).forEach(function(hotel) { %>
                <div
                    class="bg-lamaDark p-6 rounded-lg border border-lamaGold/40 hover:border-lamaNeon transition-all shadow-xl">
                    <% if (hotel.etiqueta) { %>
                        <p
                            class="text-xs font-bold text-lamaBlack bg-lamaGold inline-block px-3 py-1 rounded-full mb-3">
                            <%= hotel.etiqueta %>
                        </p>
                    <% } %>
                    <h3 class="text-xl font-headings text-lamaGold mb-2 flex items-center gap-2"><span
                            class="icon-symbol text-lamaNeon" aria-hidden="true"><%= hotel.icono || 'hotel' %></span>
                        <%= hotel.nombre %>
                    </h3>
                    <% if (hotel.ubicacion) { %>
                        <p class="text-sm text-gray-400 mb-3">
                            <%= hotel.ubicacion %>
                        </p>
                    <% } %>
                    <% if (hotel.imagenes && hotel.imagenes.length> 0) { %>
                        <div class="grid grid-cols-3 gap-2 mb-4">
                            <% hotel.imagenes.forEach(function(src) { %>
                                <img src="<%= src %>" alt="<%= hotel.nombre %>"
                                    class="w-full h-20 object-cover rounded border border-lamaGold/30">
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (hotel.descripcion) { %>
                        <p class="text-lamaBone text-sm leading-relaxed mb-4">
                            <%= hotel.descripcion %>
                        </p>
                    <% } %>
                    <% if (hotel.tarifas && hotel.tarifas.length> 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                            <% hotel.tarifas.forEach(function(tarifa) { %>
                                <div class="bg-lamaBlack p-3 rounded border border-gray-700">
                                    <p class="text-lamaNeon text-xs font-bold uppercase mb-1">
                                        <%= tarifa.nombre %>
                                    </p>
                                    <p class="text-lg font-bold text-lamaGold">
                                        <%= tarifa.valor %>
                                    </p>
                                    <p class="text-xs text-gray-400">
                                        <%= tarifa.unidad %>
                                    </p>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (hotel.nota) { %>
                        <p class="text-xs text-gray-500 mb-4">
                            <%= hotel.nota %>
                        </p>
                    <% } %>
                    <div class="flex flex-wrap gap-x-4 gap-y-2">
                        <% if (hotel.google_maps_url) { %>
                            <a href="<%= hotel.google_maps_url %>" target="_blank" rel="noopener"
                                class="inline-block text-sm font-bold text-lamaNeon hover:text-lamaGold transition-colors">Ver
                                en Google Maps →</a>
                        <% } %>
                        <% if (hotel.whatsapp_telefono) { %>
                            <a href="https://wa.me/<%= hotel.whatsapp_telefono %>?text=<%= encodeURIComponent(hotel.whatsapp_mensaje || ('Hola, quiero consultar disponibilidad en ' + hotel.nombre + ' para el V Campeonato')) %>"
                                target="_blank" rel="noopener"
                                class="inline-block text-sm font-bold text-lamaNeon hover:text-lamaGold transition-colors">Consultar
                                disponibilidad →</a>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Portafolio de Inmersión Turística -->
    <section class="bg-lamaDark py-24 border-y border-gray-800">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl md:text-6xl font-headings text-center text-lamaGold mb-4 tracking-widest">
                DESCOMPRESIÓN Y TERRITORIO
            </h2>
            <p class="text-center text-lamaBone mb-16 text-lg max-w-3xl mx-auto">
                Para contrarrestar la fatiga mecánica y el estrés térmico, el Golfo de Morrosquillo nos ofrece
                inmersión turística de primer nivel.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% (destinosTuristicos || []).forEach(function(destino) { %>
                    <div
                        class="bg-lamaBlack p-8 rounded-lg border border-gray-800 hover:border-lamaNeon transition-all text-center">
                        <div class="text-4xl mb-4"><span class="icon-symbol text-<%= destino.color_icono || 'lamaNeon' %>"
                                style="font-size: 2.5rem;" aria-hidden="true"><%= destino.icono || 'place' %></span>
                        </div>
                        <h3 class="text-xl font-headings text-lamaGold mb-3">
                            <%= destino.nombre %>
                        </h3>
                        <p class="text-lamaBone text-sm leading-relaxed">
                            <%= destino.descripcion %>
                        </p>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Alertas de Seguridad y Protocolos -->
    <section class="container mx-auto px-4 py-24">
        <h2 class="text-4xl md:text-6xl font-headings text-center text-lamaGold mb-4 tracking-widest">
            DIRECTRICES DE SEGURIDAD Y RUTA
        </h2>
        <p class="text-center text-lamaBone mb-16 text-lg max-w-3xl mx-auto">Protocolos vitales del Plan Maestro,
            de obligatorio cumplimiento para todos los pilotos.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            <div class="bg-lamaDark p-6 rounded-lg border-l-4 border-amber-400">
                <h3 class="text-lg font-headings text-amber-300 mb-2 flex items-center gap-2"><span
                        class="icon-symbol" aria-hidden="true">no_drinks</span> Consumo Responsable</h3>
                <p class="text-lamaBone text-sm leading-relaxed">Recomendamos a todos los socios esperar a que la
                    totalidad de las motocicletas estén aseguradas en los perímetros de los hoteles tras las rodadas
                    diurnas antes de consumir alcohol, priorizando siempre la seguridad de la caravana.</p>
            </div>
            <div class="bg-lamaDark p-6 rounded-lg border-l-4 border-cyan-400">
                <h3 class="text-lg font-headings text-lamaNeon mb-2 flex items-center gap-2"><span
                        class="icon-symbol" aria-hidden="true">water_drop</span> Hidratación Obligatoria</h3>
                <p class="text-lamaBone text-sm leading-relaxed">Las temperaturas del asfalto superarán los 45°C. El
                    uso de mochilas de hidratación (tipo Camelbak) es un requerimiento táctico para evitar golpes de
                    calor.</p>
            </div>
            <div class="bg-lamaDark p-6 rounded-lg border-l-4 border-lamaGold">
                <h3 class="text-lg font-headings text-lamaGold mb-2 flex items-center gap-2"><span
                        class="icon-symbol" aria-hidden="true">local_shipping</span> Protocolo Barredora</h3>
                <p class="text-lamaBone text-sm leading-relaxed">Ningún hermano se queda atrás. Contaremos con
                    vehículo de cierre equipado para rescate rápido y mecánica básica. Como toda caravana oficial
                    L.A.M.A., contaremos con nuestros Capitanes de Carretera, quienes garantizarán que ningún
                    hermano se quede atrás.</p>
            </div>
            <div class="bg-lamaDark p-6 rounded-lg border-l-4 border-cyan-400">
                <h3 class="text-lg font-headings text-lamaNeon mb-2 flex items-center gap-2"><span
                        class="icon-symbol" aria-hidden="true">rainy</span> Respuesta Inmediata</h3>
                <p class="text-lamaBone text-sm leading-relaxed">Todo piloto debe portar equipo impermeable de fácil
                    acceso (top case) para despliegue en menos de 3 minutos ante lluvias vespertinas.</p>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="bg-lamaDark py-24 border-y border-gray-800">
        <div class="container mx-auto px-4 max-w-3xl">
            <h2 class="text-4xl md:text-6xl font-headings text-center text-lamaGold mb-16 tracking-widest">
                PREGUNTAS FRECUENTES
            </h2>

            <div class="space-y-4">
                <details class="bg-lamaBlack rounded-lg border border-gray-800 p-5 group">
                    <summary class="font-headings text-lamaGold cursor-pointer list-none flex justify-between items-center">
                        ¿Cómo funciona el pago de la inscripción?
                        <span class="text-lamaNeon group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="text-lamaBone text-sm mt-3 leading-relaxed">No manejamos pasarela de pago en línea.
                        Realiza la transferencia bancaria a la cuenta institucional publicada en el formulario de
                        inscripción y adjunta el comprobante (PDF, JPG o PNG). Tesorería valida el pago y aprueba tu
                        registro.</p>
                </details>
                <details class="bg-lamaBlack rounded-lg border border-gray-800 p-5 group">
                    <summary class="font-headings text-lamaGold cursor-pointer list-none flex justify-between items-center">
                        ¿Hay devoluciones si no puedo asistir?
                        <span class="text-lamaNeon group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="text-lamaBone text-sm mt-3 leading-relaxed">Consulta la política de devoluciones vigente
                        directamente con la Tesorería Región Norte a través del canal de contacto oficial antes de
                        transferir.</p>
                </details>
                <details class="bg-lamaBlack rounded-lg border border-gray-800 p-5 group">
                    <summary class="font-headings text-lamaGold cursor-pointer list-none flex justify-between items-center">
                        ¿Puedo llevar mascota a los hoteles sede?
                        <span class="text-lamaNeon group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="text-lamaBone text-sm mt-3 leading-relaxed">El Hotel Playa Coveñas (sede oficial) no
                        tiene una política de mascotas confirmada; consulta directamente con el hotel antes de
                        reservar. Si prefieres una alternativa dog-friendly, Ciela Hotel &amp; Beach Club sí acepta
                        mascotas.</p>
                </details>
                <details class="bg-lamaBlack rounded-lg border border-gray-800 p-5 group">
                    <summary class="font-headings text-lamaGold cursor-pointer list-none flex justify-between items-center">
                        ¿Qué clima debo esperar en Coveñas?
                        <span class="text-lamaNeon group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="text-lamaBone text-sm mt-3 leading-relaxed">Clima cálido caribeño, con temperaturas de
                        asfalto que pueden superar los 45°C durante el día. Trae hidratación, protector solar y equipo
                        impermeable liviano por lluvias vespertinas.</p>
                </details>
                <details class="bg-lamaBlack rounded-lg border border-gray-800 p-5 group">
                    <summary class="font-headings text-lamaGold cursor-pointer list-none flex justify-between items-center">
                        ¿Hay código de vestimenta para la visita a la Base Militar?
                        <span class="text-lamaNeon group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="text-lamaBone text-sm mt-3 leading-relaxed">Sí: para el ingreso al Parque Museo de
                        Infantería de Marina se exige comportamiento y vestimenta respetuosos del protocolo castrense.
                        Evita prendas con mensajes ofensivos y sigue las indicaciones del personal militar en sitio.</p>
                </details>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="container mx-auto px-4 py-24 text-center">
        <h2 class="text-3xl sm:text-5xl font-headings text-white mb-6 leading-tight">
            ¿LISTO PARA LA <span class="text-lamaNeon neon-text">AVENTURA?</span>
        </h2>
        <p class="text-base sm:text-xl text-lamaBone mb-10 max-w-2xl mx-auto">
            Únete a la hermandad más exclusiva de motociclistas de Latinoamérica
        </p>
        <div class="flex flex-col md:flex-row gap-4 justify-center">
            <a href="/registro-campeonato"
                class="bg-lamaGold text-lamaBlack font-bold py-4 px-10 rounded-lg hover:bg-lamaNeon hover:scale-105 transition-all text-lg">
                REGISTRO OFICIAL
            </a>
            <a href="/eventos"
                class="border-2 border-lamaBone text-lamaBone font-bold py-4 px-10 rounded-lg hover:bg-lamaBone hover:text-lamaBlack transition-all text-lg">
                VER EVENTOS
            </a>
        </div>
    </section>

    <%- include('partials/footer') %>
