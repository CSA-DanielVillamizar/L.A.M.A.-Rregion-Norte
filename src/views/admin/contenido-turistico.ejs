<%- include('../partials/header') %>

    <nav class="bg-lamaDark border-b-2 border-lamaGold py-4">
        <div class="container mx-auto px-4 flex flex-wrap gap-3 text-sm font-bold">
            <a href="/admin/dashboard" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Inscripciones
                y Eventos</a>
            <a href="/admin/contenido-turistico" class="text-lamaGold border-b-2 border-lamaGold pb-1">Alojamiento y
                Turismo</a>
            <a href="/admin/capitulos-datos"
                class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Capítulos (Coord. y Oficiales)</a>
            <a href="/admin/planillas"
                class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Planillas de Asistencia</a>
            <a href="/checkin" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Check-in MTO</a>
        </div>
    </nav>

    <section class="container mx-auto px-4 py-12 max-w-5xl">
        <div class="flex items-center justify-between mb-8 gap-4 flex-wrap">
            <div>
                <h1 class="text-3xl font-headings text-lamaGold">ALOJAMIENTO Y TURISMO</h1>
                <p class="text-sm text-gray-400">Edita los hoteles y destinos turísticos propios de cada evento.</p>
            </div>
            <div>
                <label class="text-xs text-gray-400 block mb-1">Evento</label>
                <select id="selectorEvento"
                    class="px-3 py-2 rounded bg-lamaBlack border border-gray-700 text-lamaBone text-sm min-w-[220px]">
                    <% eventos.forEach(function(evento) { %>
                        <option value="<%= evento.id %>" <%=eventoSeleccionado && eventoSeleccionado.id===evento.id
                            ? 'selected' : '' %>>
                            <%= evento.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>
        </div>

        <% if (!eventoSeleccionado) { %>
            <p class="text-lamaBone">No hay eventos creados todavía. Crea uno primero desde <a href="/admin/dashboard"
                    class="text-lamaNeon hover:text-lamaGold">Inscripciones y Eventos</a>.</p>
        <% } else { %>

        <!-- HOTELES -->
        <div class="mb-16">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-2xl font-headings text-lamaGold">Hoteles</h2>
                <button id="btnNuevoHotel"
                    class="bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon transition-colors">+
                    Nuevo hotel</button>
            </div>
            <div id="formNuevoHotel" class="hidden bg-lamaDark border border-lamaGold/40 rounded-lg p-5 mb-4"></div>
            <div id="listaHoteles" class="space-y-4">
                <% hoteles.forEach(function(hotel) { %>
                    <div class="hotel-item bg-lamaDark border border-gray-800 rounded-lg p-5" data-id="<%= hotel.id_hotel %>">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold text-lamaGold uppercase">
                                    <%= hotel.etiqueta || (hotel.es_sede_oficial ? 'Sede oficial' : '') %>
                                    <%= hotel.activo ? '' : ' · INACTIVO' %>
                                </p>
                                <h3 class="text-lg font-headings text-lamaBone">
                                    <%= hotel.nombre %>
                                </h3>
                                <p class="text-sm text-gray-400">
                                    <%= hotel.ubicacion %>
                                </p>
                            </div>
                            <div class="flex gap-2 shrink-0">
                                <button class="btn-editar-hotel text-lamaNeon text-sm font-bold hover:text-lamaGold"
                                    data-id="<%= hotel.id_hotel %>">Editar</button>
                                <button class="btn-eliminar-hotel text-red-400 text-sm font-bold hover:text-red-300"
                                    data-id="<%= hotel.id_hotel %>">Eliminar</button>
                            </div>
                        </div>
                        <div class="form-editar-hotel hidden mt-4"></div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- DESTINOS TURÍSTICOS -->
        <div>
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-2xl font-headings text-lamaGold">Destinos turísticos</h2>
                <button id="btnNuevoDestino"
                    class="bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon transition-colors">+
                    Nuevo destino</button>
            </div>
            <div id="formNuevoDestino" class="hidden bg-lamaDark border border-lamaGold/40 rounded-lg p-5 mb-4"></div>
            <div id="listaDestinos" class="space-y-4">
                <% destinos.forEach(function(destino) { %>
                    <div class="destino-item bg-lamaDark border border-gray-800 rounded-lg p-5" data-id="<%= destino.id_destino %>">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold text-lamaGold uppercase">
                                    <%= destino.icono %>
                                    <%= destino.activo ? '' : ' · INACTIVO' %>
                                </p>
                                <h3 class="text-lg font-headings text-lamaBone">
                                    <%= destino.nombre %>
                                </h3>
                                <p class="text-sm text-gray-400">
                                    <%= destino.descripcion %>
                                </p>
                            </div>
                            <div class="flex gap-2 shrink-0">
                                <button class="btn-editar-destino text-lamaNeon text-sm font-bold hover:text-lamaGold"
                                    data-id="<%= destino.id_destino %>">Editar</button>
                                <button class="btn-eliminar-destino text-red-400 text-sm font-bold hover:text-red-300"
                                    data-id="<%= destino.id_destino %>">Eliminar</button>
                            </div>
                        </div>
                        <div class="form-editar-destino hidden mt-4"></div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- SERVICIOS PREMIUM (OPCIONALES) -->
        <div class="mt-16">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-2xl font-headings text-lamaGold">Servicios premium (opcionales)</h2>
                    <p class="text-sm text-gray-400">Atracciones adicionales con costo que el miembro puede agregar al
                        registrarse. No son obligatorias; si no cargas ninguna, esta sección no aparece en el
                        formulario.</p>
                </div>
                <button id="btnNuevoServicioPremium"
                    class="bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon transition-colors shrink-0">+
                    Nuevo servicio</button>
            </div>
            <div id="formNuevoServicioPremium" class="hidden bg-lamaDark border border-lamaGold/40 rounded-lg p-5 mb-4"></div>
            <div id="listaServiciosPremium" class="space-y-4">
                <% serviciosPremium.forEach(function(servicio) { %>
                    <div class="servicio-premium-item bg-lamaDark border border-gray-800 rounded-lg p-5" data-id="<%= servicio.id_servicio %>">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold text-lamaGold uppercase">
                                    $<%= Number(servicio.precio || 0).toLocaleString('es-CO') %>
                                    <%= servicio.activo ? '' : ' · INACTIVO' %>
                                </p>
                                <h3 class="text-lg font-headings text-lamaBone">
                                    <%= servicio.nombre %>
                                </h3>
                                <p class="text-sm text-gray-400">
                                    <%= servicio.descripcion %>
                                </p>
                            </div>
                            <div class="flex gap-2 shrink-0">
                                <button class="btn-editar-servicio-premium text-lamaNeon text-sm font-bold hover:text-lamaGold"
                                    data-id="<%= servicio.id_servicio %>">Editar</button>
                                <button class="btn-eliminar-servicio-premium text-red-400 text-sm font-bold hover:text-red-300"
                                    data-id="<%= servicio.id_servicio %>">Eliminar</button>
                            </div>
                        </div>
                        <div class="form-editar-servicio-premium hidden mt-4"></div>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>
    </section>

    <script>
        const HOTELES = <%- JSON.stringify(hoteles) %>;
        const DESTINOS = <%- JSON.stringify(destinos) %>;
        const SERVICIOS_PREMIUM = <%- JSON.stringify(serviciosPremium) %>;
        const EVENTO_SELECCIONADO_ID = <%- JSON.stringify(eventoSeleccionado ? eventoSeleccionado.id : null) %>;

        const selectorEvento = document.getElementById('selectorEvento');
        if (selectorEvento) {
            selectorEvento.addEventListener('change', () => {
                window.location.href = `/admin/contenido-turistico?evento_id=${encodeURIComponent(selectorEvento.value)}`;
            });
        }

        function campoTexto(label, name, valor, tipo) {
            const v = (valor === undefined || valor === null) ? '' : String(valor).replace(/"/g, '&quot;');
            return `<div class="mb-3"><label class="text-xs text-gray-400 block mb-1">${label}</label>
                <input type="${tipo || 'text'}" name="${name}" value="${v}"
                    class="w-full px-3 py-2 rounded bg-lamaBlack border border-gray-700 text-lamaBone text-sm focus:outline-none focus:border-lamaNeon">
            </div>`;
        }

        function campoTextarea(label, name, valor) {
            const v = (valor === undefined || valor === null) ? '' : String(valor);
            return `<div class="mb-3"><label class="text-xs text-gray-400 block mb-1">${label}</label>
                <textarea name="${name}" rows="3"
                    class="w-full px-3 py-2 rounded bg-lamaBlack border border-gray-700 text-lamaBone text-sm focus:outline-none focus:border-lamaNeon">${v}</textarea>
            </div>`;
        }

        function campoCheckbox(label, name, checked) {
            return `<div class="mb-3 flex items-center gap-2">
                <input type="checkbox" name="${name}" ${checked ? 'checked' : ''} class="w-4 h-4">
                <label class="text-sm text-lamaBone">${label}</label>
            </div>`;
        }

        function formularioHotel(hotel) {
            const h = hotel || {};
            return `
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                    ${campoTexto('Nombre *', 'nombre', h.nombre)}
                    ${campoTexto('Etiqueta (ej: ALTA GAMA)', 'etiqueta', h.etiqueta)}
                    ${campoTexto('Icono (Material Symbols, ej: hotel)', 'icono', h.icono)}
                    ${campoTexto('Ubicación', 'ubicacion', h.ubicacion)}
                    ${campoTexto('Teléfono WhatsApp (57...)', 'whatsapp_telefono', h.whatsapp_telefono)}
                    ${campoTexto('Orden', 'orden', h.orden, 'number')}
                </div>
                ${campoTextarea('Descripción', 'descripcion', h.descripcion)}
                ${campoTexto('Mensaje de WhatsApp', 'whatsapp_mensaje', h.whatsapp_mensaje)}
                ${campoTexto('URL Google Maps', 'google_maps_url', h.google_maps_url)}
                ${campoTexto('Nota (texto pequeño, opcional)', 'nota', h.nota)}
                ${campoTextarea('Imágenes (una URL por línea, opcional)', '__imagenes', (h.imagenes || []).join('\n'))}
                ${campoTextarea('Tarifas (Nombre | Valor | Unidad, una por línea, opcional)', '__tarifas', (h.tarifas || []).map(t => `${t.nombre} | ${t.valor} | ${t.unidad}`).join('\n'))}
                ${campoCheckbox('Es sede oficial', 'es_sede_oficial', h.es_sede_oficial)}
                ${campoCheckbox('Activo (visible en el sitio)', 'activo', h.activo === undefined ? true : h.activo)}
                <div class="flex gap-3 mt-3">
                    <button type="button" class="btn-guardar-hotel bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon">Guardar</button>
                    <button type="button" class="btn-cancelar text-gray-400 text-sm hover:text-lamaBone">Cancelar</button>
                </div>
            `;
        }

        function formularioDestino(destino) {
            const d = destino || {};
            return `
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                    ${campoTexto('Nombre *', 'nombre', d.nombre)}
                    ${campoTexto('Icono (Material Symbols)', 'icono', d.icono)}
                    ${campoTexto('Color (lamaNeon o lamaGold)', 'color_icono', d.color_icono || 'lamaNeon')}
                    ${campoTexto('Orden', 'orden', d.orden, 'number')}
                </div>
                ${campoTextarea('Descripción', 'descripcion', d.descripcion)}
                ${campoCheckbox('Activo (visible en el sitio)', 'activo', d.activo === undefined ? true : d.activo)}
                <div class="flex gap-3 mt-3">
                    <button type="button" class="btn-guardar-destino bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon">Guardar</button>
                    <button type="button" class="btn-cancelar text-gray-400 text-sm hover:text-lamaBone">Cancelar</button>
                </div>
            `;
        }

        function formularioServicioPremium(servicio) {
            const s = servicio || {};
            return `
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                    ${campoTexto('Nombre *', 'nombre', s.nombre)}
                    ${campoTexto('Precio (COP)', 'precio', s.precio, 'number')}
                    ${campoTexto('Icono (Material Symbols, opcional)', 'icono', s.icono)}
                    ${campoTexto('Orden', 'orden', s.orden, 'number')}
                </div>
                ${campoTextarea('Descripción', 'descripcion', s.descripcion)}
                ${campoCheckbox('Activo (visible en el formulario de inscripción)', 'activo', s.activo === undefined ? true : s.activo)}
                <div class="flex gap-3 mt-3">
                    <button type="button" class="btn-guardar-servicio-premium bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon">Guardar</button>
                    <button type="button" class="btn-cancelar text-gray-400 text-sm hover:text-lamaBone">Cancelar</button>
                </div>
            `;
        }

        function leerFormulario(container) {
            const data = {};
            container.querySelectorAll('input, textarea').forEach((el) => {
                if (el.type === 'checkbox') {
                    data[el.name] = el.checked;
                } else if (el.type === 'number') {
                    data[el.name] = Number(el.value) || 0;
                } else {
                    data[el.name] = el.value.trim();
                }
            });
            return data;
        }

        function leerFormularioHotel(container) {
            const data = leerFormulario(container);

            data.imagenes = (data.__imagenes || '')
                .split('\n')
                .map((linea) => linea.trim())
                .filter(Boolean);
            delete data.__imagenes;

            data.tarifas = (data.__tarifas || '')
                .split('\n')
                .map((linea) => linea.trim())
                .filter(Boolean)
                .map((linea) => {
                    const [nombre, valor, unidad] = linea.split('|').map((parte) => (parte || '').trim());
                    return { nombre: nombre || '', valor: valor || '', unidad: unidad || '' };
                });
            delete data.__tarifas;

            return data;
        }

        // Todo lo que sigue asume que hay un evento seleccionado (ver
        // condicional !eventoSeleccionado en la plantilla, que ni siquiera
        // renderiza estos botones si no hay eventos creados todavía).
        if (EVENTO_SELECCIONADO_ID) {

        // ---- Hoteles ----
        document.getElementById('btnNuevoHotel').addEventListener('click', () => {
            const contenedor = document.getElementById('formNuevoHotel');
            contenedor.innerHTML = formularioHotel({});
            contenedor.classList.remove('hidden');
            contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
            contenedor.querySelector('.btn-guardar-hotel').addEventListener('click', async () => {
                const data = leerFormularioHotel(contenedor);
                data.evento_id = EVENTO_SELECCIONADO_ID;
                const respuesta = await fetch('/admin/api/hoteles', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al crear el hotel');
                }
            });
        });

        document.querySelectorAll('.btn-editar-hotel').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const hotel = HOTELES.find((h) => String(h.id_hotel) === id);
                const item = document.querySelector(`.hotel-item[data-id="${id}"]`);
                const contenedor = item.querySelector('.form-editar-hotel');
                contenedor.innerHTML = formularioHotel(hotel);
                contenedor.classList.remove('hidden');
                contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
                contenedor.querySelector('.btn-guardar-hotel').addEventListener('click', async () => {
                    const data = leerFormularioHotel(contenedor);
                    data.evento_id = hotel.evento_id;
                    const respuesta = await fetch(`/admin/api/hoteles/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const resultado = await respuesta.json();
                    if (resultado.success) {
                        window.location.reload();
                    } else {
                        alert(resultado.message || 'Error al actualizar el hotel');
                    }
                });
            });
        });

        document.querySelectorAll('.btn-eliminar-hotel').forEach((btn) => {
            btn.addEventListener('click', async () => {
                if (!confirm('¿Eliminar este hotel? Esta acción no se puede deshacer.')) return;
                const id = btn.dataset.id;
                const respuesta = await fetch(`/admin/api/hoteles/${id}`, { method: 'DELETE' });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al eliminar el hotel');
                }
            });
        });

        // ---- Destinos turísticos ----
        document.getElementById('btnNuevoDestino').addEventListener('click', () => {
            const contenedor = document.getElementById('formNuevoDestino');
            contenedor.innerHTML = formularioDestino({});
            contenedor.classList.remove('hidden');
            contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
            contenedor.querySelector('.btn-guardar-destino').addEventListener('click', async () => {
                const data = leerFormulario(contenedor);
                data.evento_id = EVENTO_SELECCIONADO_ID;
                const respuesta = await fetch('/admin/api/destinos-turisticos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al crear el destino');
                }
            });
        });

        document.querySelectorAll('.btn-editar-destino').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const destino = DESTINOS.find((d) => String(d.id_destino) === id);
                const item = document.querySelector(`.destino-item[data-id="${id}"]`);
                const contenedor = item.querySelector('.form-editar-destino');
                contenedor.innerHTML = formularioDestino(destino);
                contenedor.classList.remove('hidden');
                contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
                contenedor.querySelector('.btn-guardar-destino').addEventListener('click', async () => {
                    const data = leerFormulario(contenedor);
                    data.evento_id = destino.evento_id;
                    const respuesta = await fetch(`/admin/api/destinos-turisticos/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const resultado = await respuesta.json();
                    if (resultado.success) {
                        window.location.reload();
                    } else {
                        alert(resultado.message || 'Error al actualizar el destino');
                    }
                });
            });
        });

        document.querySelectorAll('.btn-eliminar-destino').forEach((btn) => {
            btn.addEventListener('click', async () => {
                if (!confirm('¿Eliminar este destino? Esta acción no se puede deshacer.')) return;
                const id = btn.dataset.id;
                const respuesta = await fetch(`/admin/api/destinos-turisticos/${id}`, { method: 'DELETE' });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al eliminar el destino');
                }
            });
        });

        // ---- Servicios premium ----
        document.getElementById('btnNuevoServicioPremium').addEventListener('click', () => {
            const contenedor = document.getElementById('formNuevoServicioPremium');
            contenedor.innerHTML = formularioServicioPremium({});
            contenedor.classList.remove('hidden');
            contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
            contenedor.querySelector('.btn-guardar-servicio-premium').addEventListener('click', async () => {
                const data = leerFormulario(contenedor);
                data.evento_id = EVENTO_SELECCIONADO_ID;
                const respuesta = await fetch('/admin/api/servicios-premium', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al crear el servicio premium');
                }
            });
        });

        document.querySelectorAll('.btn-editar-servicio-premium').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const servicio = SERVICIOS_PREMIUM.find((s) => String(s.id_servicio) === id);
                const item = document.querySelector(`.servicio-premium-item[data-id="${id}"]`);
                const contenedor = item.querySelector('.form-editar-servicio-premium');
                contenedor.innerHTML = formularioServicioPremium(servicio);
                contenedor.classList.remove('hidden');
                contenedor.querySelector('.btn-cancelar').addEventListener('click', () => contenedor.classList.add('hidden'));
                contenedor.querySelector('.btn-guardar-servicio-premium').addEventListener('click', async () => {
                    const data = leerFormulario(contenedor);
                    data.evento_id = servicio.evento_id;
                    const respuesta = await fetch(`/admin/api/servicios-premium/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const resultado = await respuesta.json();
                    if (resultado.success) {
                        window.location.reload();
                    } else {
                        alert(resultado.message || 'Error al actualizar el servicio premium');
                    }
                });
            });
        });

        document.querySelectorAll('.btn-eliminar-servicio-premium').forEach((btn) => {
            btn.addEventListener('click', async () => {
                if (!confirm('¿Eliminar este servicio premium? Esta acción no se puede deshacer.')) return;
                const id = btn.dataset.id;
                const respuesta = await fetch(`/admin/api/servicios-premium/${id}`, { method: 'DELETE' });
                const resultado = await respuesta.json();
                if (resultado.success) {
                    window.location.reload();
                } else {
                    alert(resultado.message || 'Error al eliminar el servicio premium');
                }
            });
        });

        } // fin if (EVENTO_SELECCIONADO_ID)
    </script>

    <%- include('../partials/footer') %>
