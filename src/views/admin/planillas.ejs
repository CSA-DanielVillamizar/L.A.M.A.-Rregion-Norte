<%- include('../partials/header') %>

    <nav class="bg-lamaDark border-b-2 border-lamaGold py-4">
        <div class="container mx-auto px-4 flex flex-wrap gap-3 text-sm font-bold">
            <a href="/admin/dashboard" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Inscripciones
                y Eventos</a>
            <a href="/admin/contenido-turistico" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Alojamiento y
                Turismo</a>
            <a href="/admin/capitulos-datos" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Capítulos (Coord. y Oficiales)</a>
            <a href="/admin/planillas" class="text-lamaGold border-b-2 border-lamaGold pb-1">Planillas de Asistencia</a>
            <a href="/checkin" class="text-lamaBone hover:text-lamaNeon transition-colors pb-1">Check-in MTO</a>
        </div>
    </nav>

    <section class="container mx-auto px-4 py-12 max-w-4xl">
        <div class="mb-8">
            <h1 class="text-3xl font-headings text-lamaGold">PLANILLAS DE ASISTENCIA</h1>
            <p class="text-sm text-gray-400 mt-2">
                Genera la planilla oficial LAMA de cada capítulo a partir de las inscripciones con asistencia ya
                validada por el MTO en el punto de control. Un PDF por capítulo.
            </p>
        </div>

        <div class="bg-lamaDark border border-gray-800 rounded-lg p-5 mb-6">
            <label class="text-xs text-gray-400 block mb-1">Evento</label>
            <select id="selectorEvento" class="w-full px-3 py-2 rounded bg-lamaBlack border border-gray-700 text-lamaBone text-sm">
                <option value="">Seleccione un evento...</option>
            </select>
        </div>

        <div id="listaCapitulos" class="space-y-3"></div>
        <p id="mensajeVacio" class="text-gray-400 text-sm hidden">Este evento todavía no tiene asistentes con check-in validado.</p>
    </section>

    <script>
        const selectorEvento = document.getElementById('selectorEvento');
        const listaCapitulos = document.getElementById('listaCapitulos');
        const mensajeVacio = document.getElementById('mensajeVacio');

        async function cargarEventos() {
            const respuesta = await fetch('/admin/api/eventos');
            const datos = await respuesta.json();
            const eventos = datos.data || [];

            selectorEvento.innerHTML = '<option value="">Seleccione un evento...</option>' +
                eventos.map(e => `<option value="${e.id}">${e.nombre}</option>`).join('');

            const params = new URLSearchParams(window.location.search);
            const eventoPreseleccionado = params.get('evento');
            if (eventoPreseleccionado) {
                selectorEvento.value = eventoPreseleccionado;
                if (selectorEvento.value) cargarCapitulos(eventoPreseleccionado);
            }
        }

        selectorEvento.addEventListener('change', () => {
            const eventoId = selectorEvento.value;
            if (eventoId) cargarCapitulos(eventoId);
            else {
                listaCapitulos.innerHTML = '';
                mensajeVacio.classList.add('hidden');
            }
        });

        async function cargarCapitulos(eventoId) {
            listaCapitulos.innerHTML = '<p class="text-gray-400 text-sm">Cargando...</p>';
            mensajeVacio.classList.add('hidden');

            const respuesta = await fetch(`/admin/api/eventos/${eventoId}/capitulos-asistencia`);
            const datos = await respuesta.json();
            const capitulos = datos.data || [];

            if (capitulos.length === 0) {
                listaCapitulos.innerHTML = '';
                mensajeVacio.classList.remove('hidden');
                return;
            }

            listaCapitulos.innerHTML = capitulos.map(c => `
                <div class="bg-lamaDark border border-gray-800 rounded-lg p-4 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-lamaBone font-bold">${c.capitulo}</p>
                        <p class="text-xs text-gray-400">${c.pais || 'País no definido'} · ${c.asistentes} asistente${c.asistentes === 1 ? '' : 's'} con check-in validado</p>
                    </div>
                    <a href="/admin/eventos/${eventoId}/planilla/${encodeURIComponent(c.capitulo)}/pdf?pais=${encodeURIComponent(c.pais || '')}"
                        class="bg-lamaGold text-lamaBlack font-bold text-sm px-4 py-2 rounded hover:bg-lamaNeon transition-colors whitespace-nowrap">
                        Descargar PDF
                    </a>
                </div>
            `).join('');
        }

        cargarEventos();
    </script>

<%- include('../partials/footer') %>
