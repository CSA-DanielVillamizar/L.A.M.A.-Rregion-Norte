<%- include('../partials/header') %>

    <style>
        .epic-carousel {
            overflow: hidden;
            position: relative;
        }

        .epic-track {
            display: flex;
            gap: 1rem;
            width: max-content;
            animation: epicScroll 28s linear infinite;
        }

        .epic-carousel:hover .epic-track {
            animation-play-state: paused;
        }

        @keyframes epicScroll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }
    </style>

    <div class="container mx-auto px-4 py-16">
        <div class="max-w-4xl mx-auto">
            <a href="/eventos"
                class="inline-flex items-center text-lamaNeon hover:text-lamaGold transition-colors mb-8">
                ← Volver a eventos
            </a>

            <div class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-6">
                    <div>
                        <h1 class="text-3xl md:text-6xl font-headings text-lamaGold tracking-wider mb-2 break-words">
                            <%= event.id==='vnorte-2026' ? 'V CAMPEONATO REGION NORTE 2026' : event.nombre %>
                        </h1>
                        <p class="text-lamaNeon text-lg">Lugar: <%= event.id==='vnorte-2026'
                                ? 'Golfo de Morrosquillo · Coveñas' : event.ubicacion %>
                        </p>
                    </div>
                    <% if (event.destacado) { %>
                        <div class="bg-lamaGold text-lamaBlack px-4 py-2 rounded font-bold text-sm">DESTACADO</div>
                        <% } %>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                    <div class="bg-lamaBlack p-4 rounded border border-gray-800">
                        <div class="text-3xl font-headings text-lamaNeon neon-text mb-2">
                            <%= event.fecha.split('-')[2] %>-<%= event.fechaFin.split('-')[2] %>
                        </div>
                        <p class="text-xs text-gray-400">
                            <%= new Date(event.fecha + 'T12:00:00' ).toLocaleDateString('es-CO', { month: 'long' ,
                                year: 'numeric' }) %>
                        </p>
                    </div>
                    <div class="bg-lamaBlack p-4 rounded border border-gray-800">
                        <div class="text-3xl font-headings text-lamaGold mb-2">
                            <% if (event.paqueteOficial) { %>
                                $<%= event.paqueteOficial.valor.toLocaleString('es-CO') %>
                                    <% } else { %>
                                        <%= event.precio==null ? 'POR DEFINIR' : (event.moneda==='USD' ?
                                            ('USD ' + event.precio) : (' $' + event.precio.toLocaleString('es-CO'))) %>
                                            <% } %>
                        </div>
                        <p class="text-xs text-gray-400">INVERSIÓN <%= event.moneda || 'COP' %>
                        </p>
                    </div>
                    <div class="bg-lamaBlack p-4 rounded border border-gray-800">
                        <div
                            class="text-3xl font-headings <%= event.disponibilidad < 20 ? 'text-red-500' : 'text-lamaNeon' %> mb-2">
                            <%= event.disponibilidad %>
                        </div>
                        <p class="text-xs text-gray-400">CUPOS DISPONIBLES</p>
                    </div>
                </div>
            </div>

            <div class="bg-lamaDark rounded-lg p-8 border-l-4 border-lamaNeon shadow-xl mb-8">
                <h2 class="text-2xl font-headings text-lamaGold mb-4">DESCRIPCIÓN</h2>
                <% if (event.id==='vnorte-2026' ) { %>
                    <div class="space-y-4 text-lamaBone leading-relaxed">
                        <p>
                            El V Campeonato Region Norte ahora se vive en el eje continental Covenas - San Antero, una
                            ruta pensada para mototurismo real:
                            carretera, mar, gastronomia caribe y mas tiempo de calidad sobre la maquina.
                        </p>
                        <p>
                            Dejamos atras sobrecostos de traslados aereos y requisitos de turismo insular para dar paso
                            a una logistica eficiente,
                            accesible y enfocada en la experiencia del socio y su familia en el Golfo de Morrosquillo.
                        </p>
                    </div>
                    <% } else { %>
                        <p class="text-lamaBone leading-relaxed">
                            <%= event.descripcion %>
                        </p>
                        <% } %>
            </div>

            <% if (event.id==='vnorte-2026' ) { %>
                <div class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                    <h2 class="text-2xl font-headings text-lamaGold mb-4">INSCRIPCIÓN V CAMPEONATO REGIONAL</h2>
                    <p class="text-lamaBone mb-6">Formulario oficial para inscribirse al V Campeonato Regional.</p>
                    <a href="/registro-campeonato"
                        class="inline-flex items-center bg-lamaGold text-lamaBlack font-bold py-3 px-8 rounded-lg hover:bg-lamaNeon hover:scale-105 transition-all">IR
                        AL FORMULARIO</a>
                </div>
                <% } %>

                    <% if (event.hospedajeOficial) { %>
                        <div class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                            <h2 class="text-2xl font-headings text-lamaGold mb-2">HOTEL SEDE</h2>
                            <p class="text-lamaBone text-lg font-bold mb-1">
                                <%= event.hospedajeOficial.nombre %>
                            </p>
                            <p class="text-gray-400 text-sm mb-4">
                                <%= event.hospedajeOficial.ubicacion %>
                                <% if (event.hospedajeOficial.mapsUrl) { %>
                                    · <a href="<%= event.hospedajeOficial.mapsUrl %>" target="_blank" rel="noopener"
                                        class="text-lamaNeon hover:text-lamaGold underline">Ver en Google Maps</a>
                                    <% } %>
                            </p>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <% event.hospedajeOficial.tarifas.forEach(function(tarifa) { %>
                                    <div class="bg-lamaBlack p-5 rounded border border-gray-700">
                                        <p class="text-lamaNeon font-bold uppercase tracking-wide text-sm mb-1">
                                            <%= tarifa.nombre %>
                                        </p>
                                        <p class="text-2xl font-bold text-lamaGold mb-1">
                                            $<%= tarifa.valor.toLocaleString('es-CO') %>
                                        </p>
                                        <p class="text-xs text-gray-400 mb-3"><%= tarifa.unidad %></p>
                                        <ul class="space-y-1">
                                            <% tarifa.incluye.forEach(function(item) { %>
                                                <li class="text-lamaBone text-xs">✓ <%= item %></li>
                                                <% }); %>
                                        </ul>
                                    </div>
                                    <% }); %>
                            </div>
                            <% if (event.hospedajeOficial.nota) { %>
                                <p class="text-gray-500 text-xs mt-4"><%= event.hospedajeOficial.nota %></p>
                                <% } %>
                        </div>
                        <% } else if (event.hotel) { %>
                            <div class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                                <h2 class="text-2xl font-headings text-lamaGold mb-4">HOTEL SEDE</h2>
                                <p class="text-lamaBone text-lg font-bold">
                                    <%= event.hotel %>
                                </p>
                            </div>
                            <% } %>

                            <% if (event.paqueteOficial) { %>
                                <div
                                    class="bg-lamaDark rounded-lg p-4 md:p-8 border-l-4 border-lamaGold shadow-xl mb-8">
                                    <h2 class="text-2xl font-headings text-lamaGold mb-4">
                                        <%= event.paqueteOficial.titulo %>
                                    </h2>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                                        <div class="bg-lamaBlack p-6 rounded border border-gray-700">
                                            <p class="text-gray-400 text-sm mb-2">VALOR INSCRIPCIÓN</p>
                                            <p class="text-3xl font-bold text-lamaGold">$<%=
                                                    event.paqueteOficial.valor.toLocaleString('es-CO') %>
                                            </p>
                                            <p class="text-xs text-gray-500">(<%= event.paqueteOficial.moneda %>)</p>
                                        </div>
                                        <div class="bg-lamaBlack p-6 rounded border border-gray-700">
                                            <p class="text-gray-400 text-sm mb-3">INCLUYE:</p>
                                            <ul class="space-y-2">
                                                <% event.paqueteOficial.incluye.forEach(function(item) { %>
                                                    <li class="text-lamaBone text-sm">• <%= item %>
                                                    </li>
                                                    <% }); %>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                    <% if (event.agenda && event.agenda.length> 0) { %>
                                        <div
                                            class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                                            <h2 class="text-2xl font-headings text-lamaGold mb-6">AGENDA DETALLADA</h2>
                                            <% event.agenda.forEach(function(dia) { %>
                                                <div class="mb-8 last:mb-0">
                                                    <div
                                                        class="bg-gradient-to-r from-lamaGold/20 to-transparent p-4 rounded mb-4 border-l-4 border-lamaGold">
                                                        <h3 class="text-2xl font-bold text-lamaGold">
                                                            <% if (dia.titulo) { %>
                                                                <%= dia.titulo %>
                                                                    <% } else { %>DÍA <%= dia.dia %>
                                                                            <% } %>
                                                        </h3>
                                                        <p class="text-lamaNeon text-sm">
                                                            <%= new Date(dia.fecha + 'T12:00:00').toLocaleDateString('es-CO', {
                                                                weekday: 'long' , day: 'numeric' , month: 'long' }) %>
                                                        </p>
                                                    </div>
                                                    <div class="space-y-3">
                                                        <% dia.actividades.forEach(function(act) { %>
                                                            <div
                                                                class="bg-lamaBlack p-4 rounded border-l-2 border-lamaGold">
                                                                <div class="flex justify-between items-start mb-2">
                                                                    <span class="text-lamaGold font-bold text-lg">
                                                                        <%= act.hora %>
                                                                    </span>
                                                                    <% if (act.obligatorio) { %><span
                                                                            class="bg-red-900 text-red-200 text-xs px-2 py-1 rounded">OBLIGATORIO</span>
                                                                        <% } %>
                                                                </div>
                                                                <h4 class="text-lamaNeon font-bold mb-2">
                                                                    <%= act.titulo %>
                                                                </h4>
                                                                <% if (act.lugar) { %>
                                                                    <p class="text-gray-400 text-sm mb-2">
                                                                        <strong>Lugar:</strong>
                                                                        <%= act.lugar %>
                                                                    </p>
                                                                    <% } %>
                                                                        <% if (act.detalles) { %>
                                                                            <p class="text-lamaBone text-sm mb-2">
                                                                                <%= act.detalles %>
                                                                            </p>
                                                                            <% } %>
                                                            </div>
                                                            <% }); %>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <% } %>

                                            <% if (event.id==='vnorte-2026' ) { %>
                                                <div
                                                    class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                                                    <h2 class="text-2xl font-headings text-lamaGold mb-2">RUTA COVENAS -
                                                        SAN ANTERO</h2>
                                                    <p class="text-lamaBone mb-6">Turismo de carretera con mar al
                                                        costado, vias optimas para motos y estaciones gastronomicas en
                                                        todo el Golfo de Morrosquillo.</p>

                                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                                                        <article
                                                            class="rounded-[12px] bg-lamaBlack border border-lamaGold/30 p-5">
                                                            <h3
                                                                class="text-lamaGold font-headings text-xl tracking-wide mb-2">
                                                                Concentracion</h3>
                                                            <p class="text-lamaBone text-sm">Punto base en Covenas con
                                                                recepcion de capitulos, entrega de kits y briefing de
                                                                seguridad vial.</p>
                                                            <a href="/itinerario"
                                                                class="inline-flex mt-3 px-3 py-1 border border-lamaNeon text-lamaNeon rounded hover:bg-lamaNeon hover:text-lamaBlack transition-colors text-sm font-bold">Ver
                                                                mapa</a>
                                                        </article>
                                                        <article
                                                            class="rounded-[12px] bg-lamaBlack border border-lamaGold/30 p-5">
                                                            <h3
                                                                class="text-lamaGold font-headings text-xl tracking-wide mb-2">
                                                                Caravana Costera</h3>
                                                            <p class="text-lamaBone text-sm">Trayecto Coveñas - San
                                                                Antero con paradas tecnicas, fotografia oficial y
                                                                control logistico por bloques.</p>
                                                            <a href="/itinerario"
                                                                class="inline-flex mt-3 px-3 py-1 border border-lamaNeon text-lamaNeon rounded hover:bg-lamaNeon hover:text-lamaBlack transition-colors text-sm font-bold">Ver
                                                                ruta</a>
                                                        </article>
                                                        <article
                                                            class="rounded-[12px] bg-lamaBlack border border-lamaGold/30 p-5">
                                                            <h3
                                                                class="text-lamaGold font-headings text-xl tracking-wide mb-2">
                                                                Gastronomia Caribe</h3>
                                                            <p class="text-lamaBone text-sm">Paradas en restaurantes
                                                                locales de Coveñas y San Antero con cocina de mar y
                                                                experiencia cultural regional.</p>
                                                            <a href="/itinerario"
                                                                class="inline-flex mt-3 px-3 py-1 border border-lamaNeon text-lamaNeon rounded hover:bg-lamaNeon hover:text-lamaBlack transition-colors text-sm font-bold">Ver
                                                                puntos</a>
                                                        </article>
                                                    </div>
                                                </div>

                                                <div
                                                    class="bg-lamaDark rounded-lg p-4 md:p-8 border border-gray-800 shadow-xl mb-8">
                                                    <h2 class="text-2xl font-headings text-lamaGold mb-2">MODELO DE
                                                        PREVENTA CERRADA</h2>
                                                    <p class="text-lamaBone mb-6">La preventa cerrada asegura autonomia
                                                        logistica, compra oportuna de kits y trofeos, y control
                                                        financiero responsable de la Junta sin comprometer la economia
                                                        personal de los socios.</p>
                                                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-lamaBone">
                                                        <li>• Bloques de cupos confirmados por capitulo.</li>
                                                        <li>• Proyeccion de compras con presupuesto garantizado.</li>
                                                        <li>• Consolidacion anticipada de hospedaje y rutas.</li>
                                                        <li>• Trazabilidad de pagos y entregas para auditoria interna.
                                                        </li>
                                                    </ul>
                                                </div>
                                                <% } %>

                                                    <% if (event.costos_adicionales && event.costos_adicionales.length > 0) { %>
                                                        <div
                                                            class="bg-lamaDark rounded-lg p-8 border border-gray-800 shadow-xl mb-8">
                                                            <h2 class="text-2xl font-headings text-lamaGold mb-6">
                                                                VALORES OPCIONALES Y ADICIONALES</h2>
                                                            <div class="space-y-6">
                                                                <% event.costos_adicionales.forEach(function(categoria)
                                                                    { %>
                                                                    <div
                                                                        class="bg-lamaBlack p-6 rounded border-l-4 border-lamaNeon">
                                                                        <h3 class="text-lamaNeon font-bold mb-4">
                                                                            <%= categoria.categoria %>
                                                                        </h3>
                                                                        <ul class="space-y-3">
                                                                            <% categoria.items.forEach(function(item) {
                                                                                %>
                                                                                <li
                                                                                    class="flex justify-between items-start gap-4 pb-3 border-b border-gray-700 last:border-b-0 last:pb-0">
                                                                                    <div>
                                                                                        <p class="text-lamaBone">
                                                                                            <%= item.descripcion %>
                                                                                        </p>
                                                                                        <% if (item.unidad) { %>
                                                                                            <p
                                                                                                class="text-gray-400 text-xs">
                                                                                                (<%= item.unidad %>)</p>
                                                                                            <% } %>
                                                                                    </div>
                                                                                    <p
                                                                                        class="text-lamaGold font-bold whitespace-nowrap">
                                                                                        $<%= item.valor.toLocaleString('es-CO')
                                                                                            %>
                                                                                    </p>
                                                                                </li>
                                                                                <% }); %>
                                                                        </ul>
                                                                    </div>
                                                                    <% }); %>
                                                            </div>
                                                        </div>
                                                        <% } %>

                                                            <% if (event.recomendaciones &&
                                                                event.recomendaciones.length> 0) { %>
                                                                <div
                                                                    class="bg-lamaDark rounded-lg p-8 border-l-4 border-lamaNeon shadow-xl mb-8">
                                                                    <h2
                                                                        class="text-2xl font-headings text-lamaGold mb-4">
                                                                        RECOMENDACIONES</h2>
                                                                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                                        <% event.recomendaciones.forEach(function(item)
                                                                            { %>
                                                                            <li class="text-lamaBone">• <%= item %>
                                                                            </li>
                                                                            <% }); %>
                                                                    </ul>
                                                                </div>
                                                                <% } %>

                                                                    <% if (event.contactos) { %>
                                                                        <div
                                                                            class="bg-lamaDark rounded-lg p-8 border border-gray-800 shadow-xl mb-8">
                                                                            <h2
                                                                                class="text-2xl font-headings text-lamaGold mb-6">
                                                                                RESERVAS Y CONTACTO</h2>
                                                                            <div
                                                                                class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                                                <% event.contactos.forEach(function(contacto)
                                                                                    { %>
                                                                                    <div
                                                                                        class="bg-lamaBlack p-4 rounded border border-gray-700">
                                                                                        <p
                                                                                            class="text-gray-400 text-sm mb-1">
                                                                                            <%= contacto.tipo %>
                                                                                        </p>
                                                                                        <p
                                                                                            class="text-lamaGold font-bold">
                                                                                            <%= contacto.valor %>
                                                                                        </p>
                                                                                    </div>
                                                                                    <% }); %>
                                                                            </div>
                                                                        </div>
                                                                        <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>
